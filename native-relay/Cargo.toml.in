[package]
name = "gateway-native-relay"
version = "@VERSION@"
edition = "2024"
license = "MIT"
publish = false

[dependencies]
codex-app-server-transport = { path = "@SDK@/codex-rs/app-server-transport" }
codex-core = { path = "@SDK@/codex-rs/core" }
codex-login = { path = "@SDK@/codex-rs/login" }
codex-state = { path = "@SDK@/codex-rs/state" }
codex-utils-absolute-path = { path = "@SDK@/codex-rs/utils/absolute-path" }
tokio = { version = "1", features = ["rt-multi-thread", "macros", "sync", "signal", "process", "io-std", "io-util"] }
tokio-util = { version = "0.7", features = ["rt"] }
serde_json = "1"
libc = "0.2"
serde = { version = "1", features = ["derive"] }
url = "2"
uuid = "1"

[patch.crates-io]
crossterm = { git = "https://github.com/openai-oss-forks/crossterm", rev = "ed1cdab335221515706178d68495bba2aed1924f" }
tokio-tungstenite = { git = "https://github.com/openai-oss-forks/tokio-tungstenite", rev = "0e5b2d73aa18dd9f0a50ee9ff199d5aef7594186" }
tungstenite = { git = "https://github.com/openai-oss-forks/tungstenite-rs", rev = "4fffad30fe373adbdcffab9545e9e9bf4f2fc19f" }

[patch."ssh://git@github.com/openai-oss-forks/tungstenite-rs.git"]
tungstenite = { git = "https://github.com/openai-oss-forks/tungstenite-rs", rev = "4fffad30fe373adbdcffab9545e9e9bf4f2fc19f" }
