+#[tokio::test]
+async fn gateway_failed_queue_survives_writes_and_cold_resume() -> anyhow::Result<()> {
+    for (provider_id, marked, start_queue) in [
+        ("gatefox", false, false),
+        ("gatefox", false, true),
+        ("subscription_gateway", false, false),
+        ("subscription_gateway", false, true),
+        ("openai", true, false),
+        ("openai", true, true),
+    ] {
+        let _marker = GatewayQueueMarker::set(marked);
+        let server = start_mock_server().await;
+        let responses = responses::mount_sse_sequence(
+            &server,
+            std::iter::once(responses::sse_failed(
+                "unavailable",
+                "invalid_prompt",
+                "Provider credits or quota are exhausted",
+            ))
+            .chain(
+                (0..if start_queue { 4 } else { 5 })
+                    .map(|_| responses::sse_completed("queue-success")),
+            )
+            .collect(),
+        )
+        .await;
+        let (installed, extensions) = registered_queue_extensions();
+        let test = test_codex()
+            .with_extensions(extensions)
+            .with_config(move |config| {
+                config.model_provider_id = provider_id.to_string();
+                config.include_environment_context = false;
+            })
+            .build_with_auto_env(&server)
+            .await?;
+        let thread_id = test.session_configured.thread_id;
+        let staging = QueuedItemService::new(
+            loaded_thread_queue(&test)?,
+            Weak::new(),
+            Arc::new(NoopExtensionEventSink),
+        );
+        let first = staging.enqueue(thread_id, user_input("B")).await?;
+        let second = staging.enqueue(thread_id, user_input("C")).await?;
+        let queue = install_registered_queue(&test, installed.as_ref())?;
+        let mut watcher_extensions = ExtensionRegistryBuilder::<codex_core::config::Config>::new();
+        codex_queue_extension::install(&mut watcher_extensions, Arc::clone(&queue));
+
+        test.submit_text_turn("A").await?;
+        assert!(matches!(
+            test.codex.agent_status().await,
+            codex_protocol::protocol::AgentStatus::Errored(_)
+        ));
+        assert_eq!(
+            vec![first.clone(), second.clone()],
+            queue.list(thread_id).await?
+        );
+        let third = queue.enqueue(thread_id, user_input("D")).await?;
+        let external = staging.enqueue(thread_id, user_input("E")).await?;
+        let preserved = vec![first, second, third, external];
+        advance_queue_poll().await;
+        emit_idle(&queue, thread_id).await;
+        assert_eq!(preserved, queue.list(thread_id).await?);
+        assert_eq!(1, responses.requests().len());
+
+        let rollout = test.codex.rollout_path().context("rollout missing")?;
+        test.codex.shutdown_and_wait().await?;
+        test.thread_manager.remove_thread(&thread_id).await;
+        let resumed = test
+            .thread_manager
+            .resume_legacy_thread_from_rollout(
+                test.config.clone(),
+                rollout,
+                test.thread_manager.auth_manager(),
+                None,
+                Default::default(),
+            )
+            .await?;
+        assert!(matches!(
+            resumed.thread.agent_status().await,
+            codex_protocol::protocol::AgentStatus::Errored(_)
+        ));
+        advance_queue_poll().await;
+        emit_idle(&queue, thread_id).await;
+        assert_eq!(preserved, queue.list(thread_id).await?);
+        assert_eq!(1, responses.requests().len());
+        assert!(matches!(
+            resumed
+                .thread
+                .start_queued_turn_if_idle(TurnInputRequest::new(user_input("must stay queued")))
+                .await?,
+            codex_core::StartIfIdleSubmission::NotSubmitted { .. }
+        ));
+
+        let expected = if start_queue {
+            assert!(matches!(
+                queue.start(resumed.thread.as_ref(), None, None).await?,
+                codex_core::StartIfIdleSubmission::Started { .. }
+            ));
+            vec!["A", "B", "C", "D", "E"]
+        } else {
+            resumed
+                .thread
+                .start_or_steer_turn(TurnInputRequest::new(user_input("continue A")))
+                .await?;
+            vec!["A", "continue A", "B", "C", "D", "E"]
+        };
+        for _ in 1..expected.len() {
+            wait_for_event_with_timeout(
+                resumed.thread.as_ref(),
+                |event| matches!(event, EventMsg::TurnComplete(_)),
+                Duration::from_secs(15),
+            )
+            .await;
+        }
+        wait_for_queue_empty(&queue, thread_id).await?;
+        let prompts = responses
+            .requests()
+            .into_iter()
+            .map(|request| {
+                request
+                    .message_input_texts("user")
+                    .pop()
+                    .context("input missing")
+            })
+            .collect::<anyhow::Result<Vec<_>>>()?;
+        assert_eq!(expected, prompts);
+        resumed.thread.shutdown_and_wait().await?;
+    }
+    Ok(())
+}
