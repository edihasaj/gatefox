+#[tokio::test]
+async fn gateway_queue_change_leaves_unmarked_native_failure_behavior_intact() -> anyhow::Result<()>
+{
+    let _marker = GatewayQueueMarker::set(false);
+    let server = start_mock_server().await;
+    let responses = responses::mount_sse_sequence(
+        &server,
+        vec![
+            responses::sse_failed("native-failed", "invalid_prompt", "fixture failure"),
+            responses::sse_completed("native-follow-up"),
+        ],
+    )
+    .await;
+    let (installed, extensions) = registered_queue_extensions();
+    let test = test_codex()
+        .with_extensions(extensions)
+        .build_with_auto_env(&server)
+        .await?;
+    let staging = QueuedItemService::new(
+        loaded_thread_queue(&test)?,
+        Weak::new(),
+        Arc::new(NoopExtensionEventSink),
+    );
+    staging
+        .enqueue(test.session_configured.thread_id, user_input("B"))
+        .await?;
+    let queue = install_registered_queue(&test, installed.as_ref())?;
+    test.submit_text_turn("A").await?;
+    wait_for_event_with_timeout(
+        test.codex.as_ref(),
+        |event| matches!(event, EventMsg::TurnComplete(_)),
+        Duration::from_secs(15),
+    )
+    .await;
+    wait_for_queue_empty(&queue, test.session_configured.thread_id).await?;
+    assert_eq!(2, responses.requests().len());
+    test.codex.shutdown_and_wait().await?;
+    Ok(())
+}
