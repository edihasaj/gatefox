+// These cases run serially because the gateway marker belongs to the process.
+struct GatewayQueueMarker(Option<std::ffi::OsString>);
+
+impl GatewayQueueMarker {
+    fn set(enabled: bool) -> Self {
+        let previous = std::env::var_os("GATEFOX_EXECUTOR");
+        unsafe {
+            if enabled {
+                std::env::set_var("GATEFOX_EXECUTOR", "1");
+            } else {
+                std::env::remove_var("GATEFOX_EXECUTOR");
+            }
+        }
+        Self(previous)
+    }
+}
+
+impl Drop for GatewayQueueMarker {
+    fn drop(&mut self) {
+        unsafe {
+            match self.0.take() {
+                Some(value) => std::env::set_var("GATEFOX_EXECUTOR", value),
+                None => std::env::remove_var("GATEFOX_EXECUTOR"),
+            }
+        }
+    }
+}
