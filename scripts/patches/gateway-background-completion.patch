+use crate::session::tests::make_session_and_context_with_rx;
+use crate::session::turn_context::TurnContext;
+use crate::state::TaskKind;
+use crate::tasks::SessionTask;
+use crate::tasks::SessionTaskResult;
+use codex_protocol::config_types::ModeKind;
+use codex_protocol::protocol::TurnAbortReason;
+use tokio_util::sync::CancellationToken;
+
+struct WaitingTask;
+
+impl SessionTask for WaitingTask {
+    fn kind(&self) -> TaskKind {
+        TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "gateway_background_completion_test"
+    }
+    async fn run(
+        self: Arc<Self>,
+        _session: Arc<Session>,
+        _turn: Arc<TurnContext>,
+        _input: Vec<super::super::TurnInput>,
+        _cancel: CancellationToken,
+    ) -> SessionTaskResult {
+        std::future::pending().await
+    }
+}
+
+async fn completion(session: &Arc<Session>) -> BackgroundCompletion {
+    let hub = &session.services.unified_exec_manager.background_completions;
+    let registration = hub.register();
+    registration.arm();
+    registration
+        .publish(42, "background-call".to_string(), 7)
+        .await;
+    hub.receiver.recv().await.expect("completion fixture")
+}
+
+#[tokio::test]
+async fn gateway_background_completion_waits_for_running_turn_and_preserves_authority() {
+    let (session, turn, _rx) = make_session_and_context_with_rx().await;
+    let before = session.thread_settings_snapshot().await;
+    session.spawn_task(turn, Vec::new(), WaitingTask).await;
+    let notice = completion(&session).await;
+    assert!(!session.deliver_background_completion(&notice).await);
+    let (pending, _) = session
+        .input_queue
+        .get_pending_input(&session.active_turn)
+        .await;
+    assert!(pending.is_empty());
+    let item = completion_item(&notice);
+    assert!(crate::context::is_guardian_context_message(&item));
+    assert!(!crate::context::is_user_authorization_message(&item));
+    assert_eq!(session.thread_settings_snapshot().await, before);
+    session.abort_all_tasks(TurnAbortReason::Interrupted).await;
+}
+
+#[tokio::test]
+async fn gateway_background_completion_does_not_start_from_plan_or_interrupt() {
+    let (session, _turn, _rx) = make_session_and_context_with_rx().await;
+    {
+        let mut state = session.state.lock().await;
+        Arc::make_mut(&mut state.session_configuration.step_settings)
+            .collaboration_mode
+            .mode = ModeKind::Plan;
+    }
+    let before = session.thread_settings_snapshot().await;
+    assert!(
+        session
+            .deliver_background_completion(&completion(&session).await)
+            .await
+    );
+    assert!(session.active_turn.lock().await.is_none());
+    assert_eq!(session.thread_settings_snapshot().await, before);
+    session.mark_interrupted();
+    assert!(
+        session
+            .deliver_background_completion(&completion(&session).await)
+            .await
+    );
+    assert!(session.active_turn.lock().await.is_none());
+}
+
+#[tokio::test]
+async fn gateway_background_completion_retries_finishing_boundary_without_injection() {
+    let (session, turn, _rx) = make_session_and_context_with_rx().await;
+    session.spawn_task(turn, Vec::new(), WaitingTask).await;
+    session
+        .active_turn
+        .lock()
+        .await
+        .as_mut()
+        .expect("active")
+        .finishing = Some(CancellationToken::new());
+    let notice = completion(&session).await;
+    assert!(!session.deliver_background_completion(&notice).await);
+    assert!(
+        session
+            .input_queue
+            .get_pending_input(&session.active_turn)
+            .await
+            .0
+            .is_empty()
+    );
+    session
+        .services
+        .unified_exec_manager
+        .background_completions
+        .cancel();
+    assert!(session.deliver_background_completion(&notice).await);
+    session.abort_all_tasks(TurnAbortReason::Interrupted).await;
+}
+
+#[tokio::test]
+async fn gateway_background_completion_direct_interrupt_cancels_after_resume() {
+    let (session, _turn, _rx) = make_session_and_context_with_rx().await;
+    let notice = completion(&session).await;
+    session.interrupt_task().await;
+    assert!(notice.is_cancelled());
+    session
+        .agent_status
+        .send_replace(codex_protocol::protocol::AgentStatus::Running);
+    assert!(notice.is_cancelled());
+    let fresh = completion(&session).await;
+    assert!(!fresh.is_cancelled());
+}
+
+#[tokio::test]
+async fn gateway_background_completion_conditional_abort_cancels_registration() {
+    let (session, turn, _rx) = make_session_and_context_with_rx().await;
+    let turn_id = turn.sub_id.clone();
+    session.spawn_task(turn, Vec::new(), WaitingTask).await;
+    let notice = completion(&session).await;
+    assert!(
+        session
+            .abort_turn_if_active(&turn_id, TurnAbortReason::Interrupted, None)
+            .await
+    );
+    assert!(notice.is_cancelled());
+}
