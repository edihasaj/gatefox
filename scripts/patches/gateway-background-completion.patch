diff --git a/codex-rs/core/src/unified_exec/background_completion.rs b/codex-rs/core/src/unified_exec/background_completion.rs
new file mode 100644
index 0000000..e7c01bc
--- /dev/null
+++ b/codex-rs/core/src/unified_exec/background_completion.rs
@@ -0,0 +1,105 @@
+//! Opt-in command completion delivery owned by the executor, never the provider.
+
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+
+use async_channel::Receiver;
+use async_channel::Sender;
+use tokio_util::sync::CancellationToken;
+
+use super::MAX_UNIFIED_EXEC_PROCESSES;
+
+pub(crate) struct BackgroundCompletions {
+    sender: Sender<BackgroundCompletion>,
+    pub(crate) receiver: Receiver<BackgroundCompletion>,
+    generation: Mutex<CancellationToken>,
+}
+
+impl Default for BackgroundCompletions {
+    fn default() -> Self {
+        let (sender, receiver) = async_channel::bounded(MAX_UNIFIED_EXEC_PROCESSES);
+        Self {
+            sender,
+            receiver,
+            generation: Mutex::new(CancellationToken::new()),
+        }
+    }
+}
+
+impl BackgroundCompletions {
+    pub(crate) fn register(&self) -> Arc<CompletionRegistration> {
+        Arc::new(CompletionRegistration {
+            armed: AtomicBool::new(false),
+            cancelled: self
+                .generation
+                .lock()
+                .unwrap_or_else(|e| e.into_inner())
+                .child_token(),
+            sender: self.sender.clone(),
+        })
+    }
+
+    /// A stop invalidates existing registrations even if the next user turn resumes.
+    pub(crate) fn cancel(&self) {
+        let mut generation = self.generation.lock().unwrap_or_else(|e| e.into_inner());
+        generation.cancel();
+        *generation = CancellationToken::new();
+    }
+}
+
+pub(crate) struct CompletionRegistration {
+    armed: AtomicBool,
+    cancelled: CancellationToken,
+    sender: Sender<BackgroundCompletion>,
+}
+
+impl CompletionRegistration {
+    pub(crate) fn cancel(&self) {
+        self.cancelled.cancel();
+    }
+
+    pub(crate) fn arm(&self) {
+        self.armed.store(true, Ordering::Release);
+    }
+
+    pub(crate) async fn publish(
+        self: &Arc<Self>,
+        session_id: i32,
+        call_id: String,
+        exit_code: i32,
+    ) {
+        if self.cancelled.is_cancelled() || !self.armed.swap(false, Ordering::AcqRel) {
+            return;
+        }
+        let notice = BackgroundCompletion {
+            registration: Arc::clone(self),
+            session_id,
+            call_id,
+            exit_code,
+        };
+        tokio::select! {
+            biased;
+            _ = self.cancelled.cancelled() => {},
+            _ = self.sender.send(notice) => {},
+        }
+    }
+}
+
+pub(crate) struct BackgroundCompletion {
+    registration: Arc<CompletionRegistration>,
+    pub(crate) session_id: i32,
+    pub(crate) call_id: String,
+    pub(crate) exit_code: i32,
+}
+
+impl BackgroundCompletion {
+    pub(crate) fn is_cancelled(&self) -> bool {
+        self.registration.cancelled.is_cancelled()
+    }
+}
+
+#[cfg(test)]
+#[path = "background_completion_tests.rs"]
+mod tests;
diff --git a/codex-rs/core/src/unified_exec/background_completion_tests.rs b/codex-rs/core/src/unified_exec/background_completion_tests.rs
new file mode 100644
index 0000000..c28c609
--- /dev/null
+++ b/codex-rs/core/src/unified_exec/background_completion_tests.rs
@@ -0,0 +1,53 @@
+use super::*;
+
+#[tokio::test]
+async fn gateway_background_completion_requires_arm_and_publishes_once() {
+    let hub = BackgroundCompletions::default();
+    let registration = hub.register();
+    registration.publish(42, "call".to_string(), 0).await;
+    assert!(hub.receiver.try_recv().is_err());
+    registration.arm();
+    registration.publish(42, "call".to_string(), 7).await;
+    registration.publish(42, "call".to_string(), 7).await;
+    let notice = hub.receiver.try_recv().expect("armed completion");
+    assert_eq!(
+        (notice.session_id, notice.call_id.as_str(), notice.exit_code),
+        (42, "call", 7)
+    );
+    assert!(!notice.is_cancelled());
+    assert!(hub.receiver.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn gateway_background_completion_stop_invalidates_old_generation_only() {
+    let hub = BackgroundCompletions::default();
+    let old = hub.register();
+    old.arm();
+    old.publish(1, "old".to_string(), 0).await;
+    let queued = hub.receiver.try_recv().expect("queued before stop");
+    hub.cancel();
+    assert!(queued.is_cancelled());
+    old.arm();
+    old.publish(1, "old".to_string(), 0).await;
+    assert!(hub.receiver.try_recv().is_err());
+    let new = hub.register();
+    new.arm();
+    new.publish(2, "new".to_string(), 0).await;
+    assert!(
+        !hub.receiver
+            .try_recv()
+            .expect("new registration")
+            .is_cancelled()
+    );
+}
+
+#[tokio::test]
+async fn gateway_background_completion_collected_result_cancels_queued_notice() {
+    let hub = BackgroundCompletions::default();
+    let registration = hub.register();
+    registration.arm();
+    registration.publish(42, "call".to_string(), 0).await;
+    let notice = hub.receiver.try_recv().expect("published completion");
+    registration.cancel();
+    assert!(notice.is_cancelled());
+}
diff --git a/codex-rs/core/src/session/background_completion.rs b/codex-rs/core/src/session/background_completion.rs
new file mode 100644
index 0000000..ca6f32e
--- /dev/null
+++ b/codex-rs/core/src/session/background_completion.rs
@@ -0,0 +1,70 @@
+//! Deliver runtime observations through the same admission rules as queued work.
+
+use std::sync::Arc;
+
+use crate::context::ContextualUserFragment;
+use crate::context::InternalContextSource;
+use crate::context::InternalModelContextFragment;
+use crate::unified_exec::background_completion::BackgroundCompletion;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::turn_input::NotSubmittedReason;
+use codex_protocol::turn_input::TurnInput;
+use codex_protocol::turn_input::TurnInputMode;
+use codex_protocol::turn_input::TurnInputRequest;
+use codex_protocol::turn_input::TurnInputSubmission;
+use codex_protocol::turn_input::TurnStartOptions;
+
+use super::session::Session;
+
+fn completion_item(notice: &BackgroundCompletion) -> ResponseItem {
+    ContextualUserFragment::into(InternalModelContextFragment::new(
+        InternalContextSource::from_static("background_exec"),
+        serde_json::json!({
+            "event": "command_completed",
+            "session_id": notice.session_id,
+            "call_id": notice.call_id,
+            "exit_code": notice.exit_code,
+        })
+        .to_string(),
+    ))
+}
+
+impl Session {
+    /// False means a lifecycle boundary or a non-regular task must settle first.
+    pub(crate) async fn deliver_background_completion(
+        self: &Arc<Self>,
+        notice: &BackgroundCompletion,
+    ) -> bool {
+        if notice.is_cancelled() || self.automatic_queue_paused().await {
+            return true;
+        }
+        // Keep the receipt until the running turn has fully settled. Injecting after
+        // a final response was chosen could otherwise persist it without sampling it.
+        if self.active_turn.lock().await.is_some() {
+            return false;
+        }
+        let request = TurnInputRequest::new(TurnInput::ResponseItem(completion_item(notice)))
+            .on_start(TurnStartOptions {
+                turn_trigger: Some("background_exec".to_string()),
+                ..Default::default()
+            });
+        match super::turn_input::handle(
+            self,
+            request,
+            TurnInputMode::StartQueuedIfIdle,
+            super::new_submission_id(),
+        )
+        .await
+        {
+            Ok(TurnInputSubmission::NotSubmitted {
+                reason: NotSubmittedReason::NotIdle | NotSubmittedReason::PendingTriggerTurn,
+            }) => false,
+            // Plan mode, drain, errors and explicit stops never become an automatic retry loop.
+            _ => true,
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "background_completion_tests.rs"]
+mod tests;
