+#[test]
+fn gateway_role_context_requires_marked_managed_role_and_bounded_pair() {
+    assert_eq!(
+        gateway_role_context_limits(true, Some("managed/coding"), Some(131072), Some(104857))
+            .unwrap(),
+        (Some(131072), Some(104857))
+    );
+    assert_eq!(
+        gateway_role_context_limits(false, Some("managed/coding"), Some(131072), Some(104857))
+            .unwrap(),
+        (None, None)
+    );
+    assert_eq!(
+        gateway_role_context_limits(true, Some("gpt-6.1-sol"), Some(131072), Some(104857)).unwrap(),
+        (None, None)
+    );
+    assert_eq!(
+        gateway_role_context_limits(true, Some("managed/coding"), None, None).unwrap(),
+        (None, None)
+    );
+    for (window, limit) in [
+        (Some(131072), None),
+        (None, Some(104857)),
+        (Some(0), Some(1024)),
+        (Some(262145), Some(104857)),
+        (Some(131072), Some(131072)),
+        (Some(131072), Some(-1)),
+    ] {
+        assert!(gateway_role_context_limits(true, Some("managed/coding"), window, limit).is_err());
+    }
+}
