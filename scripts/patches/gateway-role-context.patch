+#[test]
+fn gateway_role_context_requires_marked_managed_role_and_bounded_pair() {
+    assert_eq!(
+        gateway_role_context_limits(true, Some("managed/coding"), Some(131072), Some(104857))
+            .unwrap(),
+        (Some(131072), Some(104857))
+    );
+    assert_eq!(
+        gateway_role_context_limits(false, Some("managed/coding"), Some(131072), Some(104857))
+            .unwrap(),
+        (None, None)
+    );
+    assert_eq!(
+        gateway_role_context_limits(true, Some("gpt-6.1-sol"), Some(131072), Some(104857)).unwrap(),
+        (None, None)
+    );
+    assert_eq!(
+        gateway_role_context_limits(true, Some("managed/coding"), None, None).unwrap(),
+        (None, None)
+    );
+    for (window, limit) in [
+        (Some(131072), None),
+        (None, Some(104857)),
+        (Some(0), Some(1024)),
+        (Some(262145), Some(104857)),
+        (Some(131072), Some(131072)),
+        (Some(131072), Some(-1)),
+    ] {
+        assert!(gateway_role_context_limits(true, Some("managed/coding"), window, limit).is_err());
+    }
+}
+
+#[tokio::test]
+async fn gateway_role_context_projection_preserves_other_runtime_policy() {
+    let (_home, config) = test_config_with_cli_overrides(Vec::new()).await;
+    let overrides = AgentRoleOverrides {
+        model_context_window: Some(131072),
+        model_auto_compact_token_limit: Some(104857),
+        ..Default::default()
+    };
+    let layer = TomlValue::try_from(&overrides).unwrap();
+    let next = role_overrides::build_next_config(&config, layer, &overrides).unwrap();
+    let mut expected = config.clone();
+    expected.config_layer_stack = next.config_layer_stack.clone();
+    expected.model_context_window = Some(131072);
+    expected.model_auto_compact_token_limit = Some(104857);
+    assert_eq!(next, expected);
+}
+
+#[test]
+fn gateway_role_context_named_qwen_requires_marker_and_bounded_pair() {
+    let model = Some("qwen/qwen3.8-flash-next");
+    assert_eq!(
+        gateway_role_context_limits(true, model, Some(100000), Some(90000)).unwrap(),
+        (Some(100000), Some(90000))
+    );
+    assert_eq!(
+        gateway_role_context_limits(false, model, Some(100000), Some(90000)).unwrap(),
+        (None, None)
+    );
+    assert_eq!(
+        gateway_role_context_limits(true, Some("codex/gpt-6.1-sol"), Some(100000), Some(90000)).unwrap(),
+        (None, None)
+    );
+    assert!(gateway_role_context_limits(true, model, Some(100000), None).is_err());
+    assert!(gateway_role_context_limits(true, model, Some(100000), Some(90001)).is_err());
+}
