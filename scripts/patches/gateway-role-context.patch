+// Managed and named Qwen role limits survive SDK catalog misses without changing
+// native roles, permissions, tool execution, model selection or reasoning effort.
+fn gateway_role_context_limits(
+    marked: bool,
+    model: Option<&str>,
+    window: Option<i64>,
+    compact: Option<i64>,
+) -> anyhow::Result<(Option<i64>, Option<i64>)> {
+    if !marked
+        || !model.is_some_and(|value| {
+            value.starts_with("managed/") || value == "qwen/qwen3.8-flash-next"
+        })
+    {
+        return Ok((None, None));
+    }
+    match (window, compact) {
+        (None, None) => Ok((None, None)),
+        (Some(window), Some(compact))
+            if (4096..=262144).contains(&window)
+                && compact >= 1024
+                && compact <= window * 9 / 10 =>
+        {
+            Ok((Some(window), Some(compact)))
+        }
+        _ => Err(anyhow!(
+            "Managed role context limits must be paired and bounded"
+        )),
+    }
+}
