+/// Sets the gateway executor marker for one case and restores it after. The gate runs these cases on one thread.
+struct GatewayExecutorMarker(Option<std::ffi::OsString>);
+
+impl GatewayExecutorMarker {
+    fn set(enabled: bool) -> Option<Self> {
+        let key = codex_model_provider_info::GATEWAY_EXECUTOR_ENV_VAR;
+        enabled.then(|| {
+            let original = std::env::var_os(key);
+            unsafe {
+                std::env::set_var(key, "1");
+            }
+            Self(original)
+        })
+    }
+}
+
+impl Drop for GatewayExecutorMarker {
+    fn drop(&mut self) {
+        let key = codex_model_provider_info::GATEWAY_EXECUTOR_ENV_VAR;
+        unsafe {
+            match &self.0 {
+                Some(value) => std::env::set_var(key, value),
+                None => std::env::remove_var(key),
+            }
+        }
+    }
+}
+
