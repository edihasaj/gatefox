+/// Harness Gateway: a gateway-managed executor runs with this variable set to `1`.
+pub const GATEWAY_EXECUTOR_ENV_VAR: &str = "HARNESS_GATEWAY_EXECUTOR";
+/// Harness Gateway: the provider id gateway chats were recorded with before the native identity.
+pub const LEGACY_GATEWAY_PROVIDER_ID: &str = "subscription_gateway";
+
+/// Harness Gateway: whether this process is a gateway-managed executor.
+pub fn gateway_executor_marker() -> bool {
+    std::env::var_os(GATEWAY_EXECUTOR_ENV_VAR).is_some_and(|value| value == "1")
+}
+
+/// Harness Gateway: whether a base URL is plain HTTP on this machine's loopback interface.
+pub fn is_loopback_http_base_url(base_url: Option<&str>) -> bool {
+    base_url
+        .and_then(|value| url::Url::parse(value).ok())
+        .is_some_and(|url| {
+            url.scheme() == "http"
+                && match url.host() {
+                    Some(url::Host::Domain(host)) => host.eq_ignore_ascii_case("localhost"),
+                    Some(url::Host::Ipv4(address)) => address.is_loopback(),
+                    Some(url::Host::Ipv6(address)) => address.is_loopback(),
+                    None => false,
+                }
+        })
+}
+
+/// Harness Gateway: whether a provider is the gateway's own, given whether the executor marker is set.
+/// The legacy id always is; `openai` is only inside a marked executor and only on loopback HTTP.
+pub fn is_gateway_executor_provider_with_marker(
+    provider_id: &str,
+    provider: &ModelProviderInfo,
+    marker: bool,
+) -> bool {
+    provider_id == LEGACY_GATEWAY_PROVIDER_ID
+        || (marker
+            && provider_id == OPENAI_PROVIDER_ID
+            && is_loopback_http_base_url(provider.base_url.as_deref()))
+}
+
+/// Harness Gateway: whether a provider is the gateway's own in this process.
+pub fn is_gateway_executor_provider(provider_id: &str, provider: &ModelProviderInfo) -> bool {
+    is_gateway_executor_provider_with_marker(provider_id, provider, gateway_executor_marker())
+}
+
+/// Harness Gateway: inside a marked executor, `openai` names the gateway's own provider when it is
+/// configured on loopback HTTP, so new gateway chats are recorded under the native identity while
+/// inference, authentication, retries and timeouts stay those of the gateway provider. Outside a
+/// marked executor, or without such a provider, the built-in `openai` provider is unchanged.
+pub fn alias_gateway_executor_provider(
+    model_providers: &mut HashMap<String, ModelProviderInfo>,
+    marker: bool,
+) {
+    if !marker {
+        return;
+    }
+    let Some(gateway) = model_providers.get(LEGACY_GATEWAY_PROVIDER_ID) else {
+        return;
+    };
+    if !is_loopback_http_base_url(gateway.base_url.as_deref()) {
+        return;
+    }
+    let gateway = gateway.clone();
+    model_providers.insert(OPENAI_PROVIDER_ID.to_string(), gateway);
+}
+
 /// Merge configured providers into the built-in provider catalog.
 ///
 /// Configured providers extend the built-in set. Built-in providers are not
@@ -729,6 +793,7 @@ pub fn merge_configured_model_providers(
             model_providers.entry(key).or_insert(provider);
         }
     }
+    alias_gateway_executor_provider(&mut model_providers, gateway_executor_marker());
 
     Ok(model_providers)
 }
