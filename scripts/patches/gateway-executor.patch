+
+fn gateway_provider(base_url: &str) -> ModelProviderInfo {
+    ModelProviderInfo {
+        name: "Harness Gateway".into(),
+        base_url: Some(base_url.into()),
+        supports_websockets: false,
+        request_max_retries: Some(2),
+        stream_idle_timeout_ms: Some(90_000),
+        ..Default::default()
+    }
+}
+
+#[test]
+fn gateway_executor_loopback_base_urls() {
+    for url in [
+        "http://127.0.0.1:4318/v1",
+        "http://localhost:4318/v1",
+        "http://LOCALHOST/v1",
+        "http://[::1]:4318/v1",
+        "http://127.0.0.2:4318/v1",
+    ] {
+        assert!(is_loopback_http_base_url(Some(url)), "{url}");
+    }
+    for url in [
+        "https://127.0.0.1:4318/v1",
+        "http://api.openai.com/v1",
+        "http://localhost.example.com/v1",
+        "http://10.0.0.1/v1",
+        "not a url",
+    ] {
+        assert!(!is_loopback_http_base_url(Some(url)), "{url}");
+    }
+    assert!(!is_loopback_http_base_url(None));
+}
+
+#[test]
+fn gateway_executor_aliases_openai_only_when_marked_and_local() {
+    let gateway = gateway_provider("http://127.0.0.1:4318/v1");
+    let mut marked = built_in_model_providers(/*openai_base_url*/ None);
+    marked.insert(LEGACY_GATEWAY_PROVIDER_ID.to_string(), gateway.clone());
+    alias_gateway_executor_provider(&mut marked, /*marker*/ true);
+    assert_eq!(marked[OPENAI_PROVIDER_ID], gateway);
+    assert!(!marked[OPENAI_PROVIDER_ID].is_openai());
+
+    let mut unmarked = built_in_model_providers(/*openai_base_url*/ None);
+    unmarked.insert(LEGACY_GATEWAY_PROVIDER_ID.to_string(), gateway);
+    alias_gateway_executor_provider(&mut unmarked, /*marker*/ false);
+    assert!(unmarked[OPENAI_PROVIDER_ID].is_openai());
+
+    let mut remote = built_in_model_providers(/*openai_base_url*/ None);
+    remote.insert(
+        LEGACY_GATEWAY_PROVIDER_ID.to_string(),
+        gateway_provider("https://gateway.example/v1"),
+    );
+    alias_gateway_executor_provider(&mut remote, /*marker*/ true);
+    assert!(remote[OPENAI_PROVIDER_ID].is_openai());
+
+    let mut absent = built_in_model_providers(/*openai_base_url*/ None);
+    alias_gateway_executor_provider(&mut absent, /*marker*/ true);
+    assert!(absent[OPENAI_PROVIDER_ID].is_openai());
+}
+
+#[test]
+fn gateway_executor_provider_needs_marker_and_loopback_for_openai() {
+    let local = gateway_provider("http://127.0.0.1:4318/v1");
+    let remote = gateway_provider("https://gateway.example/v1");
+    assert!(is_gateway_executor_provider_with_marker(
+        LEGACY_GATEWAY_PROVIDER_ID,
+        &remote,
+        /*marker*/ false
+    ));
+    assert!(is_gateway_executor_provider_with_marker(
+        OPENAI_PROVIDER_ID,
+        &local,
+        /*marker*/ true
+    ));
+    assert!(!is_gateway_executor_provider_with_marker(
+        OPENAI_PROVIDER_ID,
+        &local,
+        /*marker*/ false
+    ));
+    assert!(!is_gateway_executor_provider_with_marker(
+        OPENAI_PROVIDER_ID,
+        &remote,
+        /*marker*/ true
+    ));
+    assert!(!is_gateway_executor_provider_with_marker(
+        "ollama", &local, /*marker*/ true
+    ));
+}
