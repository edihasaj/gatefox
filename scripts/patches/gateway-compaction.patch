+#[test_case::test_case("subscription_gateway", None, None, false; "gateway current model")]
+#[test_case::test_case("subscription_gateway", Some("same"), Some("same"), false; "gateway compatible hash")]
+#[test_case::test_case("subscription_gateway", Some("old"), Some("new"), true; "gateway changed hash")]
+#[test_case::test_case("openai", None, None, true; "native behavior unchanged")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn gateway_pre_sampling_compaction_stays_in_selected_user_turn(
+    provider_id: &'static str,
+    previous_hash: Option<&str>,
+    next_hash: Option<&str>,
+    previous_compactor: bool,
+) {
+    skip_if_no_network!();
+    let server = MockServer::start().await;
+    let previous_model = "gpt-5.4";
+    let next_model = "gpt-5.2";
+    let mut previous_info = model_info_with_context_window(previous_model, 273_000);
+    previous_info.comp_hash = previous_hash.map(str::to_string);
+    let mut next_info = model_info_with_context_window(next_model, 125_000);
+    next_info.comp_hash = next_hash.map(str::to_string);
+    mount_models_once(
+        &server,
+        ModelsResponse {
+            models: vec![previous_info, next_info],
+        },
+    )
+    .await;
+    let request_log = mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_assistant_message("gateway-before", "before switch"),
+                ev_completed_with_tokens("gateway-r1", 120_000),
+            ]),
+            sse(vec![
+                ev_assistant_message("gateway-summary", "SELECTED_MODEL_SUMMARY"),
+                ev_completed_with_tokens("gateway-r2", 10),
+            ]),
+            sse(vec![
+                ev_assistant_message("gateway-after", "after switch"),
+                ev_completed_with_tokens("gateway-r3", 100),
+            ]),
+        ],
+    )
+    .await;
+    let model_provider = non_openai_model_provider(&server);
+    let mut builder = test_codex()
+        .with_auth(CodexAuth::create_dummy_chatgpt_auth_for_testing())
+        .with_model(previous_model)
+        .with_config(move |config| {
+            config.model_provider_id = provider_id.to_string();
+            config.model_provider = model_provider;
+            set_test_compact_prompt(config);
+        });
+    let test = builder
+        .build(&server)
+        .await
+        .expect("build gateway test codex");
+    test.codex
+        .start_or_steer_turn(disabled_permission_user_turn(
+            "before switch",
+            test.cwd.path().to_path_buf(),
+            previous_model.to_string(),
+        ))
+        .await
+        .expect("submit first user turn");
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    test.codex
+        .start_or_steer_turn(disabled_permission_user_turn(
+            "after switch",
+            test.cwd.path().to_path_buf(),
+            next_model.to_string(),
+        ))
+        .await
+        .expect("submit second user turn");
+    // The actual compaction and answer must retain the submitted user's ID.
+    assert_compaction_uses_turn_lifecycle_id(&test.codex).await;
+    let requests = request_log.requests();
+    assert_eq!(requests.len(), 3, "one seed, one compact, one answer");
+    assert_eq!(
+        requests[0].body_json()["model"].as_str(),
+        Some(previous_model)
     );
+    assert_eq!(
+        requests[1].body_json()["model"].as_str(),
+        Some(if previous_compactor {
+            previous_model
+        } else {
+            next_model
+        })
+    );
+    assert_eq!(requests[2].body_json()["model"].as_str(), Some(next_model));
+    assert!(body_contains_text(
+        &requests[1].body_json().to_string(),
+        SUMMARIZATION_PROMPT
+    ));
+    assert!(body_contains_text(
+        &requests[2].body_json().to_string(),
+        "SELECTED_MODEL_SUMMARY"
+    ));
 }
 
