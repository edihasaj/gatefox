+/// The caller declares which dynamic tools are deferred, but only search-capable models can discover
+/// them. Without search, a declared-deferred tool would be stranded, so it stays directly callable,
+/// as MCP tools already do. Hidden, DirectModelOnly and every other exposure are untouched.
+fn dynamic_tool_exposure(declared: ToolExposure, supports_search_tool: bool) -> ToolExposure {
+    if !supports_search_tool && declared == ToolExposure::Deferred {
+        ToolExposure::Direct
+    } else {
+        declared
+    }
+}
+
+fn register_dynamic_tool(
+    registry: &mut ToolRegistry,
+    handler: DynamicToolHandler,
+    supports_search_tool: bool,
+) {
+    let exposure = dynamic_tool_exposure(handler.exposure(), supports_search_tool);
+    registry.register_external_with_exposure(Arc::new(handler), exposure);
+}
