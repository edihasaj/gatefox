+//! Declared-deferred client tools stay callable when the selected model cannot search.
+use super::*;
+use crate::tools::registry::ToolRegistry;
+use codex_extension_api::ToolPolicy;
+use pretty_assertions::assert_eq;
+
+const AUTOMATION: &str = "automation_update";
+
+fn automation_name() -> String {
+    ToolName::namespaced("codex_app", AUTOMATION).to_string()
+}
+
+fn deferred_client_tools() -> Vec<DynamicToolSpec> {
+    vec![
+        dynamic_tool(Some("codex_app"), AUTOMATION, /*defer_loading*/ true),
+        dynamic_tool(
+            /*namespace*/ None,
+            "flat_deferred",
+            /*defer_loading*/ true,
+        ),
+    ]
+}
+
+fn select_model(turn: &mut TurnContext, supports_search_tool: bool) {
+    update_turn_settings_for_test(turn, |settings| {
+        let model = Arc::make_mut(&mut settings.model_info);
+        model.supports_search_tool = supports_search_tool;
+        model.use_responses_lite = false;
+    });
+}
+
+/// The shape of a gateway catalog row: no search, tools called directly.
+fn select_direct_model(turn: &mut TurnContext, supports_search_tool: bool) {
+    select_model(turn, supports_search_tool);
+    update_turn_settings_for_test(turn, |settings| {
+        Arc::make_mut(&mut settings.model_info).tool_mode = Some(ToolMode::Direct);
+    });
+}
+
+async fn probe_dynamic(
+    supports_search_tool: bool,
+    dynamic_tools: Vec<DynamicToolSpec>,
+) -> ToolPlanProbe {
+    probe_with(
+        |turn| select_direct_model(turn, supports_search_tool),
+        ToolPlanInputs {
+            dynamic_tools,
+            ..ToolPlanInputs::default()
+        },
+    )
+    .await
+}
+
+fn spec_json(plan: &ToolPlanProbe, name: &str) -> serde_json::Value {
+    serde_json::to_value(plan.visible_spec(name)).expect("tool spec should serialize")
+}
+
+#[tokio::test]
+async fn gateway_dynamic_tool_declared_deferred_falls_back_to_direct_without_search() {
+    let plan = probe_dynamic(/*supports_search_tool*/ false, deferred_client_tools()).await;
+
+    assert_eq!(plan.exposure(&automation_name()), ToolExposure::Direct);
+    assert_eq!(plan.exposure("flat_deferred"), ToolExposure::Direct);
+    plan.assert_visible_contains(&["codex_app", "flat_deferred"]);
+    plan.assert_visible_lacks(&["tool_search"]);
+    plan.assert_registered_lacks(&["tool_search"]);
+    assert_eq!(plan.namespace_function_names("codex_app"), [AUTOMATION]);
+    // The model sees an ordinary callable tool, not a deferred stub.
+    let ToolSpec::Namespace(namespace) = plan.visible_spec("codex_app") else {
+        panic!("expected the client namespace to be visible");
+    };
+    let ResponsesApiNamespaceTool::Function(tool) = &namespace.tools[0] else {
+        panic!("expected a namespace function tool");
+    };
+    assert_eq!(tool.defer_loading, None);
+}
+
+#[tokio::test]
+async fn gateway_dynamic_tool_fallback_matches_the_tool_declared_direct() {
+    let fallback = probe_dynamic(/*supports_search_tool*/ false, deferred_client_tools()).await;
+    let declared_direct = probe_dynamic(
+        /*supports_search_tool*/ false,
+        vec![
+            dynamic_tool(Some("codex_app"), AUTOMATION, /*defer_loading*/ false),
+            dynamic_tool(
+                /*namespace*/ None,
+                "flat_deferred",
+                /*defer_loading*/ false,
+            ),
+        ],
+    )
+    .await;
+
+    for name in ["codex_app", "flat_deferred"] {
+        assert_eq!(
+            spec_json(&fallback, name),
+            spec_json(&declared_direct, name)
+        );
+    }
+    assert_eq!(fallback.exposures, declared_direct.exposures);
+}
+
+#[tokio::test]
+async fn gateway_dynamic_tool_search_capable_model_keeps_deferred_discovery() {
+    let plan = probe_dynamic(/*supports_search_tool*/ true, deferred_client_tools()).await;
+
+    assert_eq!(plan.exposure(&automation_name()), ToolExposure::Deferred);
+    assert_eq!(plan.exposure("flat_deferred"), ToolExposure::Deferred);
+    plan.assert_visible_contains(&["tool_search"]);
+    plan.assert_visible_lacks(&["codex_app", "flat_deferred"]);
+    plan.assert_registered_contains(&[&automation_name(), "flat_deferred", "tool_search"]);
+}
+
+#[tokio::test]
+async fn gateway_dynamic_tool_declared_direct_is_unaffected_by_search_support() {
+    let eager = || {
+        vec![
+            dynamic_tool(Some("codex_app"), AUTOMATION, /*defer_loading*/ false),
+            dynamic_tool(
+                /*namespace*/ None,
+                "flat_direct",
+                /*defer_loading*/ false,
+            ),
+        ]
+    };
+    for supports_search_tool in [false, true] {
+        let plan = probe_dynamic(supports_search_tool, eager()).await;
+        assert_eq!(plan.exposure(&automation_name()), ToolExposure::Direct);
+        assert_eq!(plan.exposure("flat_direct"), ToolExposure::Direct);
+        plan.assert_visible_contains(&["codex_app", "flat_direct"]);
+        // A search-capable plan may carry tool_search for other deferred built-in tools, so compare it
+        // with the same plan without client tools instead of asserting its absence.
+        let baseline = probe_dynamic(supports_search_tool, Vec::new()).await;
+        assert_eq!(
+            plan.visible_names.iter().any(|name| name == "tool_search"),
+            baseline
+                .visible_names
+                .iter()
+                .any(|name| name == "tool_search"),
+            "declared-direct client tools must not change tool_search visibility"
+        );
+    }
+}
+
+#[tokio::test]
+async fn gateway_dynamic_tool_registration_leaves_the_caller_declaration_unchanged() {
+    let declared = deferred_client_tools();
+    let before = serde_json::to_value(&declared).expect("declaration should serialize");
+    for supports_search_tool in [false, true] {
+        let (_, mut turn) = make_session_and_context().await;
+        select_direct_model(&mut turn, supports_search_tool);
+        let mcp = codex_mcp::McpBinding::empty(mcp_config_for_test(&turn.config));
+        let mut registry = build_core_tool_registry(
+            &turn,
+            turn.model_info(),
+            &turn.initial_environments,
+            &mcp,
+            /*tool_suggest_candidates*/ None,
+            /*wait_for_environment_tool_config*/ None,
+        );
+        let hosted = append_source_tools(
+            &turn,
+            turn.model_info(),
+            &mut registry,
+            Vec::new(),
+            std::iter::empty::<Arc<dyn for<'call> ToolExecutor<ExtensionToolCall<'call>>>>(),
+            &declared,
+        );
+        let _router = ToolRouter::from_registry(
+            &turn,
+            turn.model_info(),
+            registry,
+            hosted,
+            &Default::default(),
+        );
+        assert_eq!(
+            serde_json::to_value(&declared).expect("declaration should serialize"),
+            before
+        );
+    }
+}
+
+#[tokio::test]
+async fn gateway_dynamic_tool_fallback_honors_the_tool_policy() {
+    let (_, mut turn) = make_session_and_context().await;
+    select_direct_model(&mut turn, /*supports_search_tool*/ false);
+    let mut registry = ToolRegistry::with_tool_policy(Arc::new(ToolPolicy {
+        allowed_tools: Some(vec![ToolName::plain("allowed_dynamic")]),
+        ..Default::default()
+    }));
+    let hosted = append_source_tools(
+        &turn,
+        turn.model_info(),
+        &mut registry,
+        Vec::new(),
+        std::iter::empty::<Arc<dyn for<'call> ToolExecutor<ExtensionToolCall<'call>>>>(),
+        &[
+            dynamic_tool(
+                /*namespace*/ None,
+                "allowed_dynamic",
+                /*defer_loading*/ true,
+            ),
+            dynamic_tool(
+                /*namespace*/ None,
+                "denied_dynamic",
+                /*defer_loading*/ true,
+            ),
+            dynamic_tool(Some("denied_ns"), AUTOMATION, /*defer_loading*/ true),
+        ],
+    );
+    let plan = ToolPlanProbe::from_router(ToolRouter::from_registry(
+        &turn,
+        turn.model_info(),
+        registry,
+        hosted,
+        &Default::default(),
+    ));
+
+    assert_eq!(plan.exposure("allowed_dynamic"), ToolExposure::Direct);
+    plan.assert_registered_lacks(&[
+        "denied_dynamic",
+        &ToolName::namespaced("denied_ns", AUTOMATION).to_string(),
+    ]);
+    plan.assert_visible_lacks(&["denied_dynamic", "denied_ns"]);
+}
+
+#[tokio::test]
+async fn gateway_dynamic_tool_fallback_honors_code_mode_namespace_settings() {
+    let plan = probe_with(
+        |turn| {
+            set_features(turn, &[Feature::CodeMode, Feature::CodeModeOnly]);
+            select_model(turn, /*supports_search_tool*/ false);
+            update_config(turn, |config| {
+                config.code_mode.direct_only_tool_namespaces = vec!["direct_only".to_string()];
+                config.code_mode.excluded_tool_namespaces = vec!["excluded".to_string()];
+            });
+        },
+        ToolPlanInputs {
+            dynamic_tools: vec![
+                dynamic_tool(Some("direct_only"), "lookup", /*defer_loading*/ true),
+                dynamic_tool(Some("excluded"), "lookup", /*defer_loading*/ true),
+                dynamic_tool(Some("nested"), "lookup", /*defer_loading*/ true),
+            ],
+            ..ToolPlanInputs::default()
+        },
+    )
+    .await;
+
+    // A direct-only namespace stays model-visible; an excluded one never enters exec.
+    let direct_only = ToolName::namespaced("direct_only", "lookup");
+    let excluded = ToolName::namespaced("excluded", "lookup");
+    let nested = ToolName::namespaced("nested", "lookup");
+    assert_eq!(
+        plan.exposure(&direct_only.to_string()),
+        ToolExposure::DirectModelOnly
+    );
+    plan.assert_visible_contains(&["direct_only"]);
+    plan.assert_visible_lacks(&["tool_search", "excluded", "nested"]);
+    let in_exec = |name: &ToolName| {
+        plan.code_mode_tool_names
+            .values()
+            .any(|nested| nested == name)
+    };
+    assert!(in_exec(&nested), "fallback tool must be callable via exec");
+    assert!(
+        !in_exec(&excluded),
+        "excluded namespace must stay out of exec"
+    );
+    assert!(
+        !in_exec(&direct_only),
+        "direct-only namespace must stay out of exec"
+    );
+}
