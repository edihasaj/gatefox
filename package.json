{
  "name": "@edihasaj/gatefox",
  "version": "1.8.6",
  "private": true,
  "type": "module",
  "description": "A local gateway that serves subscription and API providers to agent harnesses through Responses and Messages APIs.",
  "license": "MIT",
  "bin": {
    "gatefox": "dist/cli.js",
    "gateway": "dist/cli.js",
    "harness-gateway": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/gateway-sdk-pin.json",
    "dist/gateway-feature-schema-data.json",
    "dist/auth/*.js",
    "dist/auth/*.d.ts",
    "dist/providers/*.js",
    "dist/providers/*.d.ts",
    "dist/protocol/*.js",
    "dist/protocol/*.d.ts",
    "dist/app-management/*.js",
    "dist/app-management/*.d.ts",
    "dist/app-updates/*.js",
    "dist/app-updates/*.d.ts",
    "dist/app-background/*.js",
    "dist/app-background/*.d.ts",
    "dist/model-auto-latest/*.js",
    "dist/model-auto-latest/*.d.ts",
    "dist/availability/*.js",
    "dist/availability/*.d.ts",
    "LICENSE",
    "scripts/codex-desktop-shim",
    "scripts/e2e-fast-mode.mjs",
    "scripts/e2e-direct-tools.mjs",
    "README.md",
    "docs",
    "scripts/claude-desktop-adapter.mjs",
    "scripts/claude-desktop-optional-tools.mjs",
    "scripts/claude-desktop-native-messages.mjs"
  ],
  "scripts": {
    "build": "node scripts/sync-provider-tool-contract.mjs && tsc",
    "sdk:pins": "node scripts/sync-gateway-sdk-pins.mjs",
    "providers:update": "node scripts/provider-maintenance.mjs --apply",
    "providers:check": "node scripts/provider-maintenance.mjs",
    "providers:test": "node --test scripts/tests/provider-*.test.mjs",
    "providers:schedule": "node scripts/schedule-provider-maintenance.mjs",
    "check": "node scripts/sync-provider-tool-contract.mjs --check && node scripts/sync-gateway-sdk-pins.mjs --check && tsc --noEmit",
    "test": "node scripts/run-tests.mjs && npm run test:claude-desktop && npm run test:docs",
    "test:docs": "node --test scripts/tests/docs-site*.test.mjs scripts/tests/site-release*.test.mjs",
    "app:build": "node scripts/build-macos-app.mjs",
    "app:sign": "node scripts/sign-macos-app.mjs",
    "app:test": "node scripts/test-macos-app.mjs",
    "app:e2e": "node scripts/e2e-app-wizard.mjs",
    "app:e2e:connections": "node scripts/e2e-app-connections.mjs",
    "app:e2e:auto-latest": "node scripts/e2e-auto-latest.mjs",
    "app:release": "node scripts/release-macos-app.mjs",
    "release:clean": "node scripts/release-clean.mjs",
    "version:next": "node scripts/release-version.mjs",
    "start": "node dist/cli.js serve",
    "test:claude-desktop": "node --test scripts/claude-desktop-tests/*.test.mjs",
    "docs:site": "node scripts/build-docs-site.mjs",
    "docs:review": "node scripts/review-docs-site.mjs",
    "docs:serve": "node scripts/build-docs-site.mjs && python3 -m http.server 8765 -d .state/docs-site --bind 127.0.0.1",
    "docs:deploy": "node scripts/deploy-docs-site.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/ws": "8.18.2",
    "marked": "18.1.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "bundleDependencies": [
    "ws"
  ]
}
