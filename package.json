{
  "name": "@edihasaj/harness-gateway",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "description": "A local gateway that serves subscription and API providers to agent harnesses through Responses and Messages APIs.",
  "license": "MIT",
  "bin": {
    "gateway": "dist/cli.js",
    "harness-gateway": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/auth/*.js",
    "dist/auth/*.d.ts",
    "dist/providers/*.js",
    "dist/providers/*.d.ts",
    "dist/protocol/*.js",
    "dist/protocol/*.d.ts",
    "LICENSE",
    "scripts/codex-desktop-shim",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "version:next": "node scripts/release-version.mjs",
    "start": "node dist/cli.js serve"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/ws": "8.18.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "bundleDependencies": [
    "ws"
  ]
}
